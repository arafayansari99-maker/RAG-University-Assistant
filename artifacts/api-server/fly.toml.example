# This is a sample fly.toml file for deploying to Fly.io
# This file will be auto-generated when you run: flyctl launch
# But here's a pre-configured version as reference

app = "rag-university-api"
primary_region = "iad"

[build]
  builder = "heroku"
  buildpacks = ["heroku/nodejs"]

[env]
  PORT = "3001"

[http_service]
  internal_port = 3001
  force_https = true
  auto_stop_machines = true
  auto_start_machines = true
  min_machines_running = 1

[[services]]
  protocol = "tcp"
  internal_port = 3001
  processes = ["app"]

  [services.concurrency]
    type = "connections"
    hard_limit = 1000
    soft_limit = 800

  [[services.ports]]
    port = 80
    handlers = ["http"]
    force_https = true

  [[services.ports]]
    port = 443
    handlers = ["tls", "http"]

  [services.tcp_checks]
    enabled = true
    grace_period = "5s"
    interval = "15s"
    timeout = "5s"
    restart_limit = 0

[checks]
  [checks.status]
    type = "http"
    interval = "10s"
    timeout = "5s"
    grace_period = "30s"
    method = "get"
    path = "/api/healthz"
    protocol = "http"
    success_threshold = 1
    failure_threshold = 2

# Machines configuration (optional)
[env]
  NODE_ENV = "production"

# Build phase
[build.env]
  NPM_CONFIG_PRODUCTION = "false"
