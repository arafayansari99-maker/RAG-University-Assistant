# Postgres connection string. Required - the server throws at boot without it.
# Free option: create a Neon project and copy its pooled connection string.
# Keep Neon's ?sslmode=require: pg currently treats it as verify-full (a
# deprecation warning says this becomes weaker libpq semantics in pg v9).
# If `pnpm db:push` ever misbehaves through the pooler, point it at Neon's
# direct endpoint instead by dropping `-pooler` from the hostname.
# DATABASE_URL=postgresql://user:password@ep-example-123456-pooler.c-2.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Groq API key. Without it, /api/chat/ask returns an error frame instead of an answer.
GROQ_API_KEY=

# Bearer token for write/admin routes (upload, delete, rebuild-index, analytics).
# Without it those routes reject every request.
ADMIN_TOKEN=

# Comma-separated list of browser origins allowed to call the API.
# Without it the SPA's requests are blocked by CORS.
CORS_ORIGINS=http://localhost:5174

# Port the API listens on. The Vite dev proxy defaults to 3000.
PORT=3000

# development enables pretty logs; production enables compact JSON logs.
NODE_ENV=development
