# Supabase PostgreSQL connection string.
# Prefer Supabase's transaction pooler URL for hosted API traffic:
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Use the direct database URL when running `pnpm db:push` if the pooler rejects DDL.
DATABASE_URL=

# Maximum simultaneous database connections for a small free backend.
DB_POOL_MAX=5

# Groq API key. Without it, /api/chat/ask returns an error frame instead of an answer.
GROQ_API_KEY=

# Bearer token for write/admin routes (upload, delete, rebuild-index, analytics).
# Without it those routes reject every request.
ADMIN_TOKEN=

# Comma-separated list of browser origins allowed to call the API.
# Without it the SPA's requests are blocked by CORS.
CORS_ORIGINS=http://localhost:5174

# Port the API listens on. The Vite dev proxy defaults to 3000.
PORT=3000

# development enables pretty logs; production enables compact JSON logs.
NODE_ENV=development
